{
  "name": "continuum",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:intelligence": "npm run build --workspace=packages/intelligence",
    "build:api": "npm run build --workspace=packages/api",
    "build:mcp": "npm run build --workspace=packages/mcp-server",
    "build:cli": "npm run build --workspace=packages/cli",
    "build:dashboard": "npm run build --workspace=packages/dashboard",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "start:api": "npm run start --workspace=packages/api",
    "start:mcp": "npm run start --workspace=packages/mcp-server",
    "seed": "npm run seed --workspace=packages/seed"
  }
}
