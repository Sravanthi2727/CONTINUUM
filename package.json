{
  "name": "continuum",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "cnt": "./cli/dist/index.js"
  },
  "workspaces": [
    "api",
    "cli",
    "dashboard",
    "intelligence",
    "mcp-server",
    "seed"
  ],
  "scripts": {
    "build": "npm run build:intelligence && npm run build:api && npm run build:mcp && npm run build:cli && npm run build:dashboard",
    "build:intelligence": "npm run build --workspace=intelligence",
    "build:api": "npm run build --workspace=api",
    "build:mcp": "npm run build --workspace=mcp-server",
    "build:cli": "npm run build --workspace=cli",
    "build:dashboard": "npm run build --workspace=dashboard",
    "dev:api": "npm run dev --workspace=api",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "start:api": "npm run start --workspace=api",
    "seed": "npm run seed --workspace=seed"
  }
}
